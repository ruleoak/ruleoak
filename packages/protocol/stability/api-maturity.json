    "autonomous_development": {
      "maturity": "experimental",
      "versions": [
        "0.1"
      ],
      "version_exports": [],
      "notes": "One-Intent Development v0.1 orchestrates the governed development stack internally; user intent authorizes only bounded mutation and never model self-certification or missing-evidence promotion."
    },
    "development_learning": {
      "maturity": "experimental",
      "versions": [
        "0.1"
      ],
      "version_exports": [],
      "notes": "Development Learning v0.1 generates non-authoritative candidates from completed autonomous changes; only explicit user promotion creates declared Engineering Memory, and historical learning never proves future implementations."
