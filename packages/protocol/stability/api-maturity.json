      "maturity": "experimental",
      "versions": [
        "0.1"
      ],
      "version_exports": [],
      "notes": "RuleOak Verify v0.1 is an experimental PR/change-assurance report and merge recommendation; Intent Evidence Authority remains evidence authority."
