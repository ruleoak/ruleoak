      "maturity": "preview",
      "versions": [
        "1.0"
      ],
      "version_exports": [],
      "notes": "OakSpec 1.0 is a RuleOak-authored normative interoperability profile at preview ecosystem maturity; external standard status and adoption are not claimed."
