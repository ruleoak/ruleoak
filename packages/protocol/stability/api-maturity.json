      "maturity": "experimental",
      "versions": [
        "0.1"
      ],
      "version_exports": [],
      "notes": "Semantic Diff v0.1 separates deterministic Intent deltas, observed implementation changes, inferred capability mappings, and unknown runtime effects; it is not verification evidence."
    },
