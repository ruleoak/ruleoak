{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruleoak.com/schemas/repository-understanding-v0.1.schema.json",
  "title": "RuleOak Repository Understanding Graph v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "understanding_version",
    "repository",
    "nodes",
    "edges",
    "unknowns",
    "inference",
    "summary"
  ],
  "properties": {
    "understanding_version": {
      "const": "0.1"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "root",
        "intent_manifest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "const": "."
        },
        "intent_manifest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_version",
        "adapter",
        "enabled"
      ],
      "properties": {
        "adapter_version": {
          "const": "0.1"
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object"
    },
    "engineering_memory": {
      "type": "object",
      "required": [
        "version",
        "bundles",
        "records"
      ],
      "properties": {
        "version": {
          "const": "0.1"
        },
        "bundles": {
          "type": "array"
        },
        "records": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "method",
        "source",
        "confidence"
      ],
      "properties": {
        "class": {
          "enum": [
            "OBSERVED",
            "DECLARED",
            "INFERRED"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "provenance",
        "attributes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "relation",
        "provenance",
        "attributes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "subject",
        "statement",
        "status",
        "method"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "UNKNOWN"
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
