{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ruleoak.com/schemas/engineering-memory-v0.1.schema.json",
  "title":"RuleOak Engineering Memory v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["engineering_memory_version","bundle_id","records"],
  "properties":{
    "engineering_memory_version":{"const":"0.1"},
    "bundle_id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
    "records":{"type":"array","items":{"$ref":"#/$defs/record"}}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
    "stringArray":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "provenance":{"type":"object","additionalProperties":false,"required":["class","method","source"],"properties":{"class":{"enum":["OBSERVED","DECLARED","INFERRED"]},"method":{"type":"string","minLength":1},"source":{"type":"string","minLength":1},"confidence":{"type":"number","minimum":0,"maximum":1}}},
    "record":{"type":"object","additionalProperties":false,"required":["id","type","statement","status","provenance"],"properties":{"id":{"$ref":"#/$defs/id"},"type":{"enum":["Observation","Incident","Cause","Decision","Resolution","Regression","InvariantIntroduced","Evidence","Supersession"]},"statement":{"type":"string","minLength":1},"status":{"enum":["active","historical","resolved","superseded"]},"capability_ids":{"$ref":"#/$defs/stringArray"},"invariant_ids":{"$ref":"#/$defs/stringArray"},"evidence_requirement_ids":{"$ref":"#/$defs/stringArray"},"related_record_ids":{"$ref":"#/$defs/stringArray"},"trigger_terms":{"$ref":"#/$defs/stringArray"},"required_evidence_types":{"$ref":"#/$defs/stringArray"},"plan_actions":{"$ref":"#/$defs/stringArray"},"tags":{"$ref":"#/$defs/stringArray"},"observed_at":{"type":"string","format":"date-time"},"effective_from":{"type":"string","format":"date-time"},"effective_until":{"type":"string","format":"date-time"},"provenance":{"$ref":"#/$defs/provenance"}}}
  }
}
