{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruleoak.com/schemas/family-evidence-envelope-v1.schema.json",
  "description": "Experimental family contract. Runtime validation additionally enforces strict JSON limits, uniqueness, exact references and temporal ordering. Schema validity alone establishes no trust.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "producer",
    "subject",
    "scope",
    "payloadSchema",
    "payload",
    "payloadSha256",
    "sources",
    "createdAt",
    "expiresAt",
    "claims",
    "envelopeSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "releaseId",
        "sourceSha256"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "sha256"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "payloadSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "payload": {},
    "payloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "originalSha256",
          "extractionSha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "originalSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "extractionSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "claims": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "assertion",
          "verifierId",
          "evidenceSha256"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "binding",
              "semantic_support",
              "workload_qualification",
              "effect_confirmation",
              "human_review"
            ]
          },
          "assertion": {
            "enum": [
              "supported",
              "contradicted",
              "unknown"
            ]
          },
          "verifierId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "evidenceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "envelopeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
