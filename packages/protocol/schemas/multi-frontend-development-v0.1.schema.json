{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ruleoak.com/schemas/multi-frontend-development-v0.1.schema.json",
  "title":"RuleOak Multi-Frontend Development Report v0.1",
  "type":"object",
  "required":["multi_frontend_development_version","run_id","outcome","frontend","implementation","status","model_usage","authority","verification"],
  "properties":{
    "multi_frontend_development_version":{"const":"0.1"},
    "run_id":{"type":"string","minLength":1},
    "outcome":{"type":"string","minLength":1},
    "frontend":{"type":"object","required":["surface"],"properties":{"surface":{"enum":["cli","api","chat","external-agent"]}}},
    "implementation":{"type":"object","required":["mode"],"properties":{"mode":{"enum":["managed","external"]}}},
    "status":{"enum":["PLAN_ONLY","BLOCKED","IMPLEMENTER_UNAVAILABLE","FAILED","VERIFICATION_REQUIRED","VERIFIED","STOPPED"]},
    "model_usage":{"type":"object","required":["role_calls","hosted_calls","input_tokens","output_tokens","total_tokens"],"properties":{"role_calls":{"type":"integer","minimum":0},"hosted_calls":{"type":"integer","minimum":0},"input_tokens":{"type":"integer","minimum":0},"output_tokens":{"type":"integer","minimum":0},"total_tokens":{"type":"integer","minimum":0}}},
    "authority":{"type":"object"},
    "verification":{"type":"object"}
  },
  "additionalProperties":true
}
