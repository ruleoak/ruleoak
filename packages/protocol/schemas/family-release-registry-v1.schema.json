{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruleoak.com/schemas/family-release-registry-v1.schema.json",
  "description": "Experimental family contract. Runtime validation additionally enforces strict JSON limits, uniqueness, exact references and temporal ordering. Schema validity alone establishes no trust.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "releases": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "version",
          "sourceArtifact",
          "availability",
          "packages",
          "schemas",
          "dependencies",
          "qualification"
        ],
        "properties": {
          "ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "product",
              "releaseId",
              "sourceSha256"
            ],
            "properties": {
              "product": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "releaseId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sourceSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sourceArtifact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "availability": {
            "enum": [
              "available",
              "reference_only"
            ]
          },
          "packages": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version",
                "artifactSha256"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "artifactSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "schemas": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          },
          "dependencies": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "product",
                "releaseId",
                "sourceSha256"
              ],
              "properties": {
                "product": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "releaseId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sourceSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "qualification": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "platform",
                "sourceSha256",
                "artifactSha256",
                "checkedAt",
                "expiresAt",
                "verifierId"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "source_tests",
                    "native_runtime"
                  ]
                },
                "platform": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sourceSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "artifactSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "checkedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
                },
                "expiresAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
                },
                "verifierId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    }
  }
}
