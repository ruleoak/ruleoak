{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruleoak.com/schemas/intent-recompile-v0.1.schema.json",
  "title": "RuleOak Intent Recompile Package v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent_recompile_version",
    "package_id",
    "component_id",
    "target_module",
    "baseline",
    "interface_contract",
    "invariants",
    "evidence_contract",
    "synthesis"
  ],
  "properties": {
    "intent_recompile_version": {
      "const": "0.1"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "component_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "target_module": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "source_path",
        "source_bytes",
        "source_lines"
      ],
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "source_path": {
          "type": "string"
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "source_lines": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "interface_contract": {
      "type": "object",
      "required": [
        "export",
        "input",
        "output"
      ],
      "properties": {
        "export": {
          "type": "string"
        },
        "input": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "history_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_contract": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "minimum_distinct_structure_signals",
        "weights",
        "thresholds"
      ],
      "properties": {
        "strategy": {
          "type": "string"
        },
        "minimum_distinct_structure_signals": {
          "type": "integer",
          "minimum": 1
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    }
  }
}
