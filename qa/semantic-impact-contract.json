{
  "contract_version": "1.0",
  "name": "Semantic Impact Engine",
  "impact_version": "0.1",
  "matcher": "deterministic-lexical-v0.1",
  "required_cli_commands": [
    "impact"
  ],
  "required_capabilities": [
    "cap.repository-understanding",
    "cap.semantic-impact"
